#!/usr/bin/env sh
set -eu

launcher=$0
while [ -L "$launcher" ]; do
  launcher_dir=$(CDPATH= cd -P "$(dirname "$launcher")" >/dev/null 2>&1 && pwd)
  link_target=$(readlink "$launcher")
  case "$link_target" in
    /*) launcher=$link_target ;;
    *) launcher=$launcher_dir/$link_target ;;
  esac
done

launcher_dir=$(CDPATH= cd -P "$(dirname "$launcher")" >/dev/null 2>&1 && pwd)
exec node "$launcher_dir/../dist/packages/cli/src/main.js" "$@"
